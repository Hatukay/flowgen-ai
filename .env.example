# FlowGen AI — Backend Environment Variables
# Copy this file to .env and fill in real values.
#   cp .env.example .env

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────────────────────
# Use * to allow all origins in development.
# Set your real frontend URL for production (e.g. https://flowgen.ai).
CORS_ORIGIN=*

# ── Anthropic Claude API ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── n8n Cloud ─────────────────────────────────────────────────────────────────
N8N_BASE_URL=https://your-instance.app.n8n.cloud
N8N_API_KEY=

# ── n8n Webhook (optional) ───────────────────────────────────────────────────
# When set, POST /api/tasks/:id/approve will fire a POST to this URL.
# Leave empty to skip the webhook call (non-fatal either way).
N8N_WEBHOOK_URL=
