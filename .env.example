# AI FlowOps backend environment

PORT=3001
BACKEND_PORT=3001
NODE_ENV=development
CORS_ORIGIN=*

# Google AI Studio / Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
MOCK_LLM=false

# Local n8n
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
N8N_WEBHOOK_URL=

# Demo platform credentials. Keep real values in .env only.
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
DISCORD_DEFAULT_CHANNEL_ID=
MAIL_USER=
MAIL_PASSWORD=
