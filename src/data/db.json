{
  "tasks": [
    {
      "id": "task-001-telegram-slack",
      "slug": "telegram-to-slack",
      "name": "Telegram'dan Slack'e Mesaj Köprüsü",
      "description": "Belirli bir Telegram kanalına gelen mesajları otomatik olarak şirket Slack kanalına ileten akış. Önemli duyuruların iki platform arasında kaybolmamasını sağlar.",
      "status": "active",
      "trigger": {
        "type": "webhook",
        "config": {
          "path": "/telegram-incoming",
          "method": "POST"
        }
      },
      "steps": [
        {
          "id": "step_1",
          "name": "Telegram Webhook Dinle",
          "action": "http.request",
          "description": "Telegram Bot API'den gelen webhook payload'ını yakala",
          "params": {
            "method": "POST",
            "url": "/telegram-incoming"
          }
        },
        {
          "id": "step_2",
          "name": "Mesajı Dönüştür",
          "action": "data.transform",
          "description": "Telegram mesaj formatını Slack Block Kit formatına çevir",
          "params": {
            "inputField": "message.text",
            "outputFormat": "slack_block"
          }
        },
        {
          "id": "step_3",
          "name": "Slack Kanalına Gönder",
          "action": "slack.message",
          "description": "#genel kanalına formatlı mesajı ilet",
          "params": {
            "channel": "#genel",
            "text": "📨 Telegram'dan: {{step_2.output}}"
          }
        }
      ],
      "estimatedTimeSavedMinutes": 5,
      "tags": [
        "telegram",
        "slack",
        "mesajlaşma",
        "köprü"
      ],
      "complexity": "low",
      "createdAt": "2026-05-01T08:00:00.000Z",
      "updatedAt": "2026-05-04T10:15:00.000Z"
    },
    {
      "id": "task-002-mail-summary",
      "slug": "mail-summary",
      "name": "Günlük E-posta Özet Raporu",
      "description": "Her sabah 08:00'de gelen kutusundaki okunmamış e-postaları Claude ile analiz edip önemli maddeleri çıkaran ve yöneticiye Slack DM olarak özet gönderen otomasyon.",
      "status": "active",
      "trigger": {
        "type": "schedule",
        "config": {
          "cron": "0 8 * * 1-5",
          "timezone": "Europe/Istanbul"
        }
      },
      "steps": [
        {
          "id": "step_1",
          "name": "Okunmamış E-postaları Çek",
          "action": "email.send",
          "description": "Son 24 saatteki okunmamış e-postaları Gmail API üzerinden listele",
          "params": {
            "filter": "is:unread newer_than:1d",
            "maxResults": 50
          }
        },
        {
          "id": "step_2",
          "name": "Claude ile Özetle",
          "action": "ai.generate",
          "description": "E-posta listesini Claude'a gönder, Türkçe madde madde özet iste",
          "params": {
            "model": "claude-3-5-sonnet-20241022",
            "prompt": "Aşağıdaki e-postaları önem sırasına göre Türkçe özetle: {{step_1.emails}}"
          }
        },
        {
          "id": "step_3",
          "name": "Slack DM Gönder",
          "action": "slack.message",
          "description": "Özeti yöneticinin Slack DM'ine gönder",
          "params": {
            "channel": "@yonetici",
            "text": "📬 *Günlük E-posta Özeti*\n{{step_2.output}}"
          }
        }
      ],
      "estimatedTimeSavedMinutes": 20,
      "tags": [
        "email",
        "gmail",
        "özet",
        "yapay-zeka",
        "slack"
      ],
      "complexity": "medium",
      "createdAt": "2026-05-02T09:30:00.000Z",
      "updatedAt": "2026-05-06T12:04:34.462Z"
    },
    {
      "id": "task-003-payment-reminder",
      "slug": "payment-reminder",
      "name": "Gecikmiş Ödeme Hatırlatıcısı",
      "description": "Muhasebe sistemindeki vadesi geçmiş faturalar için müşterilere otomatik e-posta ve SMS hatırlatması gönderir. 3 gün, 7 gün ve 14 günlük vade basamakları içerir.",
      "status": "active",
      "trigger": {
        "type": "schedule",
        "config": {
          "cron": "0 9 * * *",
          "timezone": "Europe/Istanbul"
        }
      },
      "steps": [
        {
          "id": "step_1",
          "name": "Vadesi Geçmiş Faturaları Sorgula",
          "action": "database.query",
          "description": "Muhasebe DB'sinden vadesi 3+ gün geçmiş açık fatura kayıtlarını çek",
          "params": {
            "query": "SELECT * FROM invoices WHERE due_date < NOW() - INTERVAL '3 days' AND status = 'open'",
            "connection": "accounting_db"
          }
        },
        {
          "id": "step_2",
          "name": "Basamak Hesapla",
          "action": "data.transform",
          "description": "Her fatura için gecikme gününe göre 3/7/14 günlük basamağı belirle",
          "params": {
            "logic": "escalation_tier"
          }
        },
        {
          "id": "step_3",
          "name": "Hatırlatma E-postası Gönder",
          "action": "email.send",
          "description": "Müşteriye basamağa uygun Türkçe şablonlu ödeme hatırlatma maili at",
          "params": {
            "template": "payment_reminder_tr",
            "to": "{{step_1.customer_email}}",
            "subject": "Ödeme Hatırlatması – Fatura #{{step_1.invoice_no}}"
          }
        },
        {
          "id": "step_4",
          "name": "Muhasebe Sistemini Güncelle",
          "action": "database.query",
          "description": "Hatırlatma gönderim tarihini ve basamağını fatura kaydına yaz",
          "params": {
            "query": "UPDATE invoices SET last_reminder_at = NOW(), reminder_tier = {{step_2.tier}} WHERE id = {{step_1.id}}"
          }
        }
      ],
      "estimatedTimeSavedMinutes": 45,
      "tags": [
        "finans",
        "ödeme",
        "hatırlatma",
        "e-posta",
        "muhasebe"
      ],
      "complexity": "high",
      "createdAt": "2026-05-03T11:00:00.000Z",
      "updatedAt": "2026-05-06T08:00:00.000Z"
    }
  ],
